{
  "manifest_version": 3,
  "name": "SiteLens",
  "version": "1.0.0",
  "description": "A simple website information analyzer.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}