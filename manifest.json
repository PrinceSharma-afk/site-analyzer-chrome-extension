{
    "manifest_version": 3,
    "name": "SiteAnalyzer",
    "version": "1.0.0",
    "description": "A simple website information analyzer.",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "tabs"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}
